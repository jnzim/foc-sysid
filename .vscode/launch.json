{
    "name": "Remote Pi debug",
    "type": "cppdbg",
    "request": "launch",
    "program": "${workspaceFolder}/build/drive",
    "args": [],
    "cwd": "${workspaceFolder}",
    "MIMode": "gdb",
    "miDebuggerPath": "/usr/bin/gdb",
    "miDebuggerServerAddress": "<pi-ip>:2345",
    "setupCommands": [
        {
            "description": "Enable pretty-printing",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
        }
    ]
}